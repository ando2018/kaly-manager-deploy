PORT=3001
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:4200
PLATFORM_ADMIN_KEY=change-me-in-production

# The platform layer (établissements list, subscription pricing/tokens, contact messages) requires
# its own dedicated Firebase project — separate from any établissement's own Firestore config.
# Not an env var: place the service-account JSON key file for that project at
#   backend/data/platform-firebase-service-account.json
# The server refuses to start until that file is present and valid.

# Outgoing e-mail (optional). Without SMTP_HOST the app sends nothing and works as before.
# Sends you a notification for every new contact message / token request (see /ap > Messages).
# Port 587 + SMTP_SECURE=false (STARTTLS) or port 465 + SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kaly Manager <no-reply@example.com>"
# Recipient(s) of the notifications, comma-separated.
NOTIFY_EMAIL=
